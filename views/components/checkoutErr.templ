package components

templ CheckoutErrors(errs map[string]string) {
	<div id="err-phone">
		if msg, ok := errs["phone"]; ok {
			<p class="mt-1 text-xs text-red-600">{ msg }</p>
		}
	</div>
	<div id="err-address">
		if msg, ok := errs["address"]; ok {
			<p class="mt-1 text-xs text-red-600">{ msg }</p>
		}
	</div>
}
