package components

templ Head(title string) {
	<head>
		<title>{ title }</title>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<link rel="icon" type="image/svg" href="/static/public/pic.svg"/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,500&display=swap"/>
		<link rel="stylesheet" href="/static/style.css">
		<script type="module" src="/static/datastar.js" defer></script>
		<script src="/static/dashboard.js" defer></script>
	</head>
}