package components

templ CategoryErrors(errs map[string]string) {
	<div id="err-name">
		if msg, ok := errs["name"]; ok {
			<p class="mt-1 text-sm text-red-600">{ msg }</p>
		}
	</div>
	<div id="err-image">
			if msg, ok := errs["image"]; ok {
				<p class="mt-1 text-sm text-red-600">{ msg }</p>
			}
	</div>
}	