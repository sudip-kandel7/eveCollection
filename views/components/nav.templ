package components

import (
	"github.com/sudip-kandel7/eveCollection/internal/db"
)

templ Nav(user *db.User, active string) {
	<nav class="sticky top-0 z-50 w-full border-b border-[#E7E5DE] bg-[#FFFFFF]">
		<div class="mx-auto flex min-h-16 max-w-7xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3 sm:px-6 md:h-16 md:py-0">

			<div class="order-1 flex items-center gap-2.5 md:order-none">
				<a href="/" class="flex items-center gap-2.5">
						<img src="/static/public/pic.svg" alt="" class="h-9 w-9 rounded-full">
					

					<span class="text-lg font-semibold text-[#20231F]">
						eve
						<span class="relative -top-1  text-xs text-[#638154]">
							|Collection
						</span>
					</span>
				</a>
			</div>

			<div class="order-3 flex w-full items-center justify-center gap-5 overflow-x-auto md:order-none md:w-auto md:justify-start md:gap-7 md:overflow-visible">
				<a href="/" class={ navLinkClass(active, "home") }>
					Home
				</a>

				<a href="/about" class={ navLinkClass(active, "about") }>
					About
				</a>
			</div>

			
			
			<div class="order-2 flex items-center gap-4 md:order-none" data-signals:cart-count="0">
    if user == nil {
        <a
            href="/login"
            class="group flex bg-[#c6d1bc] p-2 rounded-md items-center gap-2 text-sm font-medium text-[#3f4939] transition hover:bg-[#b8c6ac] text-md py-2 hover:text-[#343d2f] min-h-10 md:min-h-0"
        >
            <img
                src="/static/public/log-in.png"
                alt="Login"
                class="h-4 w-4 opacity-60 transition-opacity duration-200 group-hover:opacity-100"
            />
            <span>Login</span>
        </a>
    } else {
        <div
            class="relative"
            data-signals:profile-open="false"
        >
            <button
                type="button"
                data-on:click="$profileOpen = !$profileOpen"
                class="flex h-10 w-10 items-center justify-center md:h-auto md:w-auto"
            >
                <img
                    src="/static/public/profile.png"
                    class="h-7 w-7"
                    alt="Profile"
                />
            </button>
			
            <div
                data-show="$profileOpen"
                class="absolute right-0 z-7 top-full mt-2 rounded-lg border border-[#e1e5dc] bg-white p-3 shadow-lg sm:left-1/2 sm:right-auto sm:-translate-x-1/2"
            >
                <div class="border-b border-[#e5e8e2] px-3 pb-3">
                    <p class="text-sm font-semibold text-[#40463b]">
                        { user.Name }
                    </p>
                    <p class="mt-1 text-xs text-[#777d71]">
                        { user.Email }
                    </p>
                </div>
			
                <div class="py-2">

              		if user.Role == "admin" {
                     <a href="/admin/dashboard"
                     class="block rounded-md px-3 py-2 text-sm text-[#596052] hover:bg-[#f1f3ee]">
                    Dashboard </a>
                     <a href="/admin/orders"
                     class="block rounded-md px-3 py-2 text-sm text-[#596052] hover:bg-[#f1f3ee]">
                    Orders </a>
                  } else {
                    <a
                        href="/profile"
                        class="block rounded-md px-3 py-2 text-sm text-[#596052] hover:bg-[#f1f3ee]"
                    >
                        Profile
                    </a>
			
                    <a
                        href="/orders"
                        class="block rounded-md px-3 py-2 text-sm text-[#596052] hover:bg-[#f1f3ee]"
                    >
                        My Orders
                    </a>
                    
                  }
                </div>
			
                <div class="border-t border-[#e5e8e2] pt-2">
                    <form method="POST" action="/logout">
                        <button
                            type="submit"
                            class="w-full flex items-center justify-start gap-2 rounded-md px-3 py-2 text-left text-sm text-[#596052] hover:bg-[#f1f3ee]"
                        >
                        <img src="/static/public/logout.png" alt="Logout" class="h-4 w-4 opacity-60 transition-opacity duration-200 group-hover:opacity-100" />
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>

        if user.Role != "admin" {
            <a
                href="/cart"
                class="relative flex h-10 w-10 items-center justify-center md:h-auto md:w-auto"
                data-init="@get('/cart/count')"
            >
                <img
                    src="/static/public/cart.png"
                    class="h-7 w-7"
                    alt="Cart"
                />
                <span
                    data-show="$cartCount > 0"
                    data-text="$cartCount"
                    class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-[#283B28] px-1 text-[10px] font-semibold leading-none text-white"
                >0</span>
            </a>
        }
    }
			</div>


		</div>
	</nav>
}
const navLinkBase = "whitespace-nowrap py-2.5 text-sm font-medium transition md:py-0 "
const navLinkActive = navLinkBase + "text-[#232B1F]"
const navLinkIdle = navLinkBase + "text-[#6B7266] hover:text-[#232B1F]"

func navLinkClass(active, key string) string {
	if active == key {
		return navLinkActive
	}
	return navLinkIdle
}
