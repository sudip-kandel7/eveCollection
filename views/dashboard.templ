package views

import (
	"strconv"
	"fmt"
	"github.com/jackc/pgx/v5/pgtype"
	"github.com/sudip-kandel7/eveCollection/internal/db"
)

func textOrEmpty(t pgtype.Text) string {
	if !t.Valid {
		return ""
	}
	return t.String
}

templ dashboard(user *db.User, tab string, categories []db.ListCategoriesWithPCRow) {
	<div class="mx-auto flex h-screen w-full" data-signals:activetab={"'" + tab + "'"}>
		<aside class="w-64 shrink-0 border-r border-gray-200 bg-white">
			<div class="px-6 py-8">
				<h2 class="text-lg font-semibold text-gray-900">My Account</h2>
				<p class="mt-1 text-sm text-gray-500">Manage your account</p>
			</div>
			<nav class="px-3">
				@dashboardNavLink("overview", "Overview")
				@dashboardNavLink("category", "Category")
				@dashboardNavLink("products", "Products")
				@dashboardNavLink("orders", "Orders")
				@dashboardNavLink("messages", "Messages")
				@dashboardNavLink("reviews", "Reviews")
			</nav>
		</aside>

		<div class="flex-1">
			@OverviewContent(user)
			@OrdersAdminContent()
			@CategoryAdminContent(categories)
			@ProductsAdminContent(categories)
			@MessagesAdminContent()
			@ReviewsAdminContent()
		</div>
	</div>
}

templ dashboardNavLink(tab, label string) {
	<a	href="#"
		data-on:click__prevent={ "$activetab = '" + tab + "'" }
		data-attr:class={ "$activetab === '" + tab + "' ? 'block rounded-lg bg-gray-100 px-4 py-3 text-sm font-medium text-gray-900' : 'mt-1 block rounded-lg px-4 py-3 text-sm text-gray-600 transition hover:bg-gray-100'" }
	>
		{ label }
	</a>
}

templ OverviewContent(user *db.User) {
	<section data-show="$activetab === 'overview'" class="px-10 py-8">
		<h1 class="text-2xl font-semibold tracking-tight text-[#20231F]">Overview</h1>
		<p class="mt-2 text-sm text-[#63685F]">Your overall data will show up here.</p>
	</section>
}

templ CategoryAdminContent(categories []db.ListCategoriesWithPCRow) {
	<section id="category-admin" data-show="$activetab === 'category'" class="px-10 py-8" data-signals:formmode="'create'" data-signals:catactive="true" data-signals:catname="''" data-signals:categoryid="'0'" data-signals:catimage="''" data-signals:catpreview="''" data-signals:submitting="false">
		<h1 class="text-2xl font-semibold tracking-tight text-[#20231F]">Category</h1>
		<p class="mt-2 text-sm text-[#63685F]">Add, edit, or hide product categories.</p>

		<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[280px_1fr]">
			<div class="rounded-2xl border border-[#E5E8DF] bg-white p-6">
				<h2 class="text-sm font-semibold text-[#20231F]" data-text="$formmode === 'create' ? 'Add category' : 'Edit category'"></h2>
				<p class="mt-1 text-xs text-[#63685F]">
					<span data-show="$formmode === 'create'">Create a new product category.</span>
					<span data-show="$formmode === 'edit'">Update this category's details.</span>
				</p>
				<form class="mt-5" id="category-form" enctype="multipart/form-data"
					data-on:submit__prevent="$submitting = true; $formmode === 'create' ? @post('/admin/categories', {contentType: 'form'}) : @post('/admin/categories/' + $categoryid , {contentType: 'form'})">
					<label class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[#63685F]">Name</label>
					<input type="text" name="name" data-bind:catname
						class="w-full rounded-xl border border-[#DFE5DA] bg-white px-3 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28]"/>
					<div id="err-name" class="mt-1 text-xs text-red-600"></div>

					<label class="mt-7 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-[#DFE5DA] px-4 py-6 text-center text-xs text-[#63685F] hover:bg-[#F7F8F5]">
						<input type="file" name="image" class="hidden" accept="image/jpeg,image/png,image/jpg" data-on:change="$catimage = evt.target.files[0]?.name || ''; $catpreview = evt.target.files[0] ? URL.createObjectURL(evt.target.files[0]) : ''"
						/>
						<img data-attr:src="$catpreview" alt="" class="h-20 w-20 rounded-lg object-cover" data-show="$catpreview !== ''"/>
						<span data-show="$catimage === ''">Click to upload</span>
						<span data-show="$catimage !== ''" data-text="$catimage"></span>
					</label>
					<div id="err-image" class="mt-1 text-xs text-red-600"></div>

					<label class="mt-4 flex items-center gap-2 text-sm text-[#20231F]">
						<input type="checkbox" name="is_active" data-bind:catactive class="h-4 w-4 rounded border-[#DFE5DA]"/>
						Active
					</label>

					<div class="mt-6 flex gap-2">
						<button type="button" data-show="$formmode === 'edit'" data-on:click="$formmode = 'create'; $catname = ''; $catactive = true; $categoryid = '0'; $catimage = ''; $catpreview = ''"
							class="flex-1 whitespace-nowrap rounded-lg border border-[#DFE5DA] bg-white px-4 py-2.5 text-sm font-medium text-[#63685F] transition hover:bg-[#F0EFE9]">
							Cancel
						</button>
						<button type="submit" data-attr:disabled="$submitting"
							class="flex-1 whitespace-nowrap rounded-lg bg-[#283B28] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#3C523C]"
							data-text="$submitting ? 'Saving...' : ($formmode === 'create' ? 'Create' : 'Save changes')"
						></button>
					</div>
				</form>
			</div>

			<div class="flex flex-col gap-2">
				for _, c := range categories {
					<div
						data-attr:class={ "$categoryid === " + strconv.FormatInt(int64(c.ID), 10) + " ? 'group grid grid-cols-[40px_1fr_90px_90px_90px] items-center gap-3 rounded-xl border-2 border-[#283B28] bg-[#F7F8F5] p-3 transition hover:-translate-y-0.5 hover:shadow-md' : 'group grid grid-cols-[40px_1fr_90px_90px_90px] items-center gap-3 rounded-xl border-2 border-[#E5E8DF] bg-white p-3 transition hover:-translate-y-0.5 hover:shadow-md'" }
					>
						<img src={ textOrEmpty(c.ImageUrl) } alt="" class="h-8 w-8 rounded-lg object-cover bg-[#F0EFE9]"/>
						<span class="text-sm font-medium text-[#20231F]">{ c.Name }</span>

						<a
							href={ templ.URL("/admin/products?category=" + strconv.FormatInt(int64(c.ID), 10)) }
							class="relative inline-block text-sm font-semibold text-[#283B28] transition-colors duration-200 hover:text-[#4A704A]"
						>
							{ fmt.Sprintf("%02d", c.ProductCount) }
							<span class="absolute bottom-[-3px] left-[-2px] h-[1.5px] w-6 origin-right scale-x-0 bg-[#4A704A] transition-transform duration-300 ease-out group-hover:origin-left group-hover:scale-x-100"></span>
						</a>

						if c.IsActive {
							<span class="w-fit rounded-full bg-[#E7F3E5] px-2.5 py-0.5 text-xs font-medium text-[#2E6B33]">Active</span>
						} else {
							<span class="w-fit rounded-full bg-[#FBE9E7] px-2.5 py-0.5 text-xs font-medium text-[#B3392C]">Hidden</span>
						}

						<div class="flex gap-1.5">
							<button
								type="button"
								data-on:click={ "$formmode = 'edit'; $categoryid = " + strconv.FormatInt(int64(c.ID), 10) + "; $catname = '" + c.Name + "'; $catactive = " + strconv.FormatBool(c.IsActive)  + "; " +
                "$catpreview = " + strconv.Quote(c.ImageUrl.String) }
								class="rounded-lg border border-[#DFE5DA] p-1.5 text-[#63685F] hover:bg-[#F0EFE9]"
							>
								<img src="/static/public/edit.png" alt="Edit" class="h-4 w-4 transition-transform duration-150 ease-out hover:scale-125"/>
							</button>

							if c.ProductCount == 0 {
								<button
									type="button"
									data-on:click={ "confirm('Delete " + c.Name + "? This can\\'t be undone.') && @post('/admin/categories/" + strconv.FormatInt(int64(c.ID), 10) + "/delete')" }
									class="rounded-lg border border-red-200 p-1.5 hover:bg-red-50"
								>
									<img src="/static/public/delete.png" alt="Delete" class="h-4 w-4 transition-transform duration-150 ease-out hover:scale-125"/>
								</button>
							} else {
								<button type="button" disabled title="Move or delete its products first" class="cursor-not-allowed rounded-lg border border-[#E5E8DF] p-1.5">
									<img src="/static/public/delete.png" alt="Delete (disabled)" class="h-4 w-4 opacity-30"/>
								</button>
							}
						</div>
					</div>
				}

				if len(categories) == 0 {
					<div class="rounded-xl border border-dashed border-[#DFE5DA] p-10 text-center text-sm text-[#63685F]">
						No categories yet — create your first one on the left.
					</div>
				}
			</div>
		</div>
	</section>
}

templ ProductsAdminContent(categories []db.ListCategoriesWithPCRow) {
	<section
		id="products-admin"
		data-show="$activetab === 'products'"
		class="px-10 py-8"
		data-signals:pformmode="'edit'"
		data-signals:productid="'0'"
		data-signals:pname="''"
		data-signals:pcategory="''"
		data-signals:pdescription="''"
		data-signals:pprice="''"
		data-signals:pvisible="true"
		data-signals:psubmitting="false"
		data-signals:prowcount="1"
		data-signals:psearch="''"
		data-signals:pcatfilter="''"
	>
		<div class="grid grid-cols-1 gap-6 xl:grid-cols-2 items-start">

			<div class="rounded-2xl border border-[#E5E8DF] bg-white p-8">
				<span class="text-xs font-semibold uppercase tracking-wide text-[#8A9285]">Product details</span>
				<h2 class="mt-1 text-2xl font-bold tracking-tight text-[#20231F]" data-text="$pformmode === 'create' ? 'Add a product' : 'Edit product'"></h2>

				<form
					id="product-form"
					class="mt-6"
					enctype="multipart/form-data"
					data-on:datastar-fetch.document="evt.detail.type === 'finished' && ($psubmitting = false)"
				data-on:submit__prevent="$psubmitting = true; $pformmode === 'create' ? @post('/admin/products', {contentType: 'form'}) : @post('/admin/products/' + $productid, {contentType: 'form'})"
				>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="mb-1.5 block text-sm font-medium text-[#20231F]">Product name <span class="text-xs text-[#8A9285]">*</span></label>
							<input type="text" name="name" data-bind:pname
								class="w-full rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
								placeholder="e.g. Everyday linen shirt"/>
							<div id="err-name" class="mt-1 text-xs text-red-600"></div>
						</div>
						<div>
							<label class="mb-1.5 block text-sm font-medium text-[#20231F]">Category <span class="text-xs text-[#8A9285]">*</span></label>
							<select name="category_id" data-bind:pcategory
								class="w-full rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28]">
								<option value="" disabled selected>Choose a category</option>
								for _, c := range categories {
									<option value={ strconv.FormatInt(int64(c.ID), 10) }>{ c.Name }</option>
								}
							</select>
							<div id="err-category" class="mt-1 text-xs text-red-600"></div>
						</div>
					</div>

					<label class="block text-sm font-medium text-[#20231F]">Description</label>
					<textarea name="description" rows="3" data-bind:pdescription
						class="mt-1.5 w-full rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
						placeholder="Tell customers what makes it special..."></textarea>
					<div id="err-description" class="mt-1 text-xs text-red-600"></div>

					<div class="mt-5 grid grid-cols-[1fr_auto] items-end gap-4">
						<div>
														<label class="block text-sm font-medium text-[#20231F]">Base price <span class="text-xs text-[#8A9285]">*</span></label>
													<div class="relative mt-1.5">
														<span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-sm text-[#8A9285]">Rs.</span>
														<input type="text" name="base_price" data-bind:pprice
															class="w-full rounded-xl border border-[#DFE5DA] bg-white py-2.5 pl-10 pr-3.5  text-sm text-[#20231F] outline-none focus:border-[#283B28]"
															placeholder="0.00"/>
													</div>
													<div id="err-price" class="mt-1 text-xs text-red-600"></div>
												</div>

						<label class="flex cursor-pointer items-center gap-2 pb-2.5 text-sm font-medium text-[#20231F]">
							<input type="checkbox" name="is_active" data-bind:pvisible
								class="h-4 w-4 rounded border-[#DFE5DA]"/>
							Active
						</label>
					</div>

					<label class="block text-sm font-medium text-[#20231F]">Tags <span class="text-xs text-[#8A9285]">*</span></label>
					<div class="mt-1.5 flex flex-wrap items-center gap-2 rounded-xl border border-[#DFE5DA] bg-white px-3 py-2">
    <input
        type="text"
        id="tag-input"
        class="min-w-[120px] flex-1 border-none p-1 text-sm text-[#20231F] outline-none"
        placeholder="Add another tag..."
        data-on:keydown="
            if (evt.key === 'Enter') {
                evt.preventDefault();
                const value = evt.target.value.trim();
                if (!value) return;
                const wrap = document.createElement('div');
                wrap.className = 'flex items-center gap-2 rounded-lg bg-[#EEF2EB] px-3 py-1.5 text-sm text-[#283B28]';
                const span = document.createElement('span');
                span.textContent = value;
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'tags[]';
                hidden.value = value;
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = '×';
                btn.className = 'font-bold text-[#63685F] hover:text-red-600';
                btn.onclick = function() { wrap.remove(); };
                wrap.appendChild(hidden);
                wrap.appendChild(span);
                wrap.appendChild(btn);
                document.getElementById('tags').appendChild(wrap);
                evt.target.value = '';
            }
        "
    />
    <button type="button" id="tag" title="Add tag" aria-label="Add tag"
        data-on:click="
            const input = document.getElementById('tag-input');
            const value = input.value.trim();
            if (!value) return;
            const wrap = document.createElement('div');
            wrap.className = 'flex items-center gap-2 rounded-lg bg-[#EEF2EB] px-3 py-1.5 text-sm text-[#283B28]';
            const span = document.createElement('span');
            span.textContent = value;
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'tags[]';
            hidden.value = value;
            const btn2 = document.createElement('button');
            btn2.type = 'button';
            btn2.textContent = '×';
            btn2.className = 'font-bold text-[#63685F] hover:text-red-600';
            btn2.onclick = function() { wrap.remove(); };
            wrap.appendChild(hidden);
            wrap.appendChild(span);
            wrap.appendChild(btn2);
            document.getElementById('tags').appendChild(wrap);
            input.value = '';
        "
        class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#F0EFE9] text-sm font-semibold leading-none text-[#283B28] transition hover:bg-[#E5E8DF]">+</button>
					</div>

					<div id="tags" class="mt-3 flex flex-wrap gap-2"></div>

					<div class="mt-5 flex items-baseline justify-between">
    <label class="block text-sm font-medium text-[#20231F]">Product images <span class="text-xs text-[#8A9285]">*</span></label>
    <span class="text-xs text-[#8A9285]">First image is the cover</span>
					</div>
					<label class="mt-1.5 flex cursor-pointer items-center gap-3 rounded-xl border border-dashed border-[#DFE5DA] px-4 py-4 text-sm text-[#63685F] hover:bg-[#F7F8F5]">
    <input type="file" id="images-input" name="images" multiple class="hidden" accept="image/jpeg,image/png,image/webp"
        data-on:change="
            window.productImages = (window.productImages || []).concat(Array.from(evt.target.files));
            renderProductImages();
            evt.target.value = '';
        "/>
    <span>
        <span class="block font-medium text-[#20231F]">Upload product photos</span>
        <span class="block text-xs text-[#8A9285]">JPG, PNG or WebP · up to 2MB each</span>
    </span>
					</label>
					<div id="image-previews" class="mt-3 flex flex-wrap gap-2"></div>
					<div id="err-images" class="mt-1 text-xs text-red-600"></div>

					<script>
					function renderProductImages() {
    var container = document.getElementById('image-previews');
    container.innerHTML = '';

    window.productImages.forEach(function (f, i) {
        var wrap = document.createElement('div');
        wrap.className = 'relative';

        var img = document.createElement('img');
        img.src = URL.createObjectURL(f);
        img.className = 'h-20 w-20 rounded-xl object-cover border border-[#E5E8DF]';
        wrap.appendChild(img);

        if (i === 0) {
            var badge = document.createElement('span');
            badge.textContent = 'COVER';
            badge.className = 'absolute bottom-1 left-1 rounded bg-black/70 px-1.5 py-0.5 text-[9px] font-semibold text-white';
            wrap.appendChild(badge);
        }

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.textContent = '×';
        removeBtn.className = 'absolute -top-2 -right-2 flex h-5 w-5 items-center justify-center rounded-full bg-red-500 text-xs font-bold text-white hover:bg-red-600';
        removeBtn.onclick = function () {
            window.productImages.splice(i, 1);
            renderProductImages();
        };
        wrap.appendChild(removeBtn);

        container.appendChild(wrap);
    });

    var input = document.getElementById('images-input');
       var dt = new DataTransfer();
       window.productImages.forEach(function (f) { dt.items.add(f); });
       input.files = dt.files;
					}
					</script>

				
					<div class="mt-8 border-t border-[#E5E8DF] pt-6">
					
    <div class="flex items-center justify-between">
        <div>
            <h3 class="text-sm font-semibold text-[#20231F]">
                Variants <span class="text-xs text-[#8A9285]">*</span>
            </h3>
					
            <p class="text-xs text-[#8A9285]">
                Stock is tracked for each color and size.
            </p>
        </div>
					
        <button
            type="button"
            id="add-variant"
            class="flex items-center gap-1.5 rounded-full border border-[#DFE5DA] bg-white px-4 py-2 text-sm font-medium text-[#283B28] hover:bg-[#F0EFE9]"
        >
            + Add variant
        </button>
    </div>
					
    <div
        id="variants-container"
        class="mt-4 space-y-4"
    ></div>
					
					</div>
					
					<script>
					(function () {
    let variantIndex = 0;
					
    const container = document.getElementById('variants-container');
    const addButton = document.getElementById('add-variant');
					
    function addVariant() {					
        const index = variantIndex++;
					
        const row = document.createElement('div');
					
        row.className =
            'variant-row rounded-xl border border-[#E5E8DF] bg-[#FBFBF9] p-4';
					
        row.innerHTML = `
            <div class="flex items-center justify-between">
					
                <span class="variant-number text-xs font-semibold uppercase tracking-wide text-[#8A9285]">
                    Variant ${container.children.length + 1}
                </span>
					
                <button
                    type="button"
                    class="remove-variant text-xs font-medium text-red-500 hover:text-red-700"
                >
                    Remove
                </button>
					
            </div>
					
            <div class="mt-3 grid grid-cols-4 gap-3">
					
                <div>
                    <label class="mb-1 block text-xs font-medium text-[#63685F]">
                        Color <span class="text-xs text-[#8A9285]">*</span>
                    </label>
					
                    <input
                        type="text"
                        name="variants[${index}][color]"
                        class="w-full rounded-lg border border-[#DFE5DA] bg-white px-2.5 py-2 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
                    />
                </div>
					
                <div>
                    <label class="mb-1 block text-xs font-medium text-[#63685F]">
                        Size <span class="text-xs text-[#8A9285]">*</span>
                    </label>
					
                    <input
                        type="text"
                        name="variants[${index}][size]"
                        class="w-full rounded-lg border border-[#DFE5DA] bg-white px-2.5 py-2 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
                    />
                </div>
					
                <div>
                    <label class="mb-1 block text-xs font-medium text-[#63685F]">
                        Stock <span class="text-xs text-[#8A9285]">*</span>
                    </label>
					
                    <input
                        type="number"
                        min="0"
                        name="variants[${index}][stock]"
                        class="w-full rounded-lg border border-[#DFE5DA] bg-white px-2.5 py-2 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
                    />
                </div>
					
                <div>
                    <label class="mb-1 block text-xs font-medium text-[#63685F]">
                        Price
                    </label>
					
                    <div class="relative">
					
                        <span class="pointer-events-none absolute inset-y-0 left-2.5 flex items-center text-xs text-[#8A9285]">
                            Rs.
                        </span>
					
                        <input
                            type="text"
                            name="variants[${index}][price]"
                            placeholder="Base"
                            class="w-full rounded-lg border border-[#DFE5DA] bg-white py-2 pl-8 pr-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
                        />
					
                    </div>
                </div>
					
            </div>
        `;
					
        container.appendChild(row);
					
        updateVariantNumbers();
        updateRemoveButtons();
    }
					
    function removeVariant(row) {
					
        row.remove();
					
        updateVariantNumbers();
        updateRemoveButtons();
    }
					
    function updateVariantNumbers() {
					
        const rows = container.querySelectorAll('.variant-row');
					
        rows.forEach(function (row, index) {
					
            const title = row.querySelector('.variant-number');
					
            title.textContent = 'Variant ' + (index + 1);
        });
    }
					
    function updateRemoveButtons() {
					
        const rows = container.children;
					
        const buttons =
            container.querySelectorAll('.remove-variant');
					
        buttons.forEach(function (button) {
					
            button.style.display =
                rows.length > 1 ? '' : 'none';
        });
    }
					
    addButton.addEventListener('click', function () {
        addVariant();
    });
					
    container.addEventListener('click', function (event) {
					
        const button =
            event.target.closest('.remove-variant');
					
        if (!button) {
            return;
        }
					
        const row =
            button.closest('.variant-row');
					
        if (row) {
            removeVariant(row);
        }
    });
					
    addVariant();
					
					})();
					</script>
            

					<div class="mt-8 flex items-center justify-between border-t border-[#E5E8DF] pt-6">
						<span class="text-xs text-[#8A9285]">* Required fields</span>
						<div class="flex gap-2">
							<button type="button" data-show="$pformmode === 'edit'"
								data-on:click="$pformmode = 'create'; $productid = '0'; $pname = ''; $pcategory = ''; $pdescription = ''; $pprice = ''; $pvisible = true; document.getElementById('tags').innerHTML = ''; document.getElementById('tag-input').value = ''; window.productImages = []; renderProductImages(); resetVariants()"
								class="flex-1 whitespace-nowrap rounded-lg border border-[#DFE5DA] bg-white px-4 py-2.5 text-sm font-medium text-[#63685F] transition hover:bg-[#F0EFE9]">
								Cancel
							</button>
							<script>
							function resetVariants() {
								variantIndex = 0;
								container.innerHTML = '';
								addVariant();
							}
							</script>
							<button type="submit" data-attr:disabled="$psubmitting"
								class="flex-1 whitespace-nowrap rounded-lg bg-[#283B28] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#3C523C]"
								data-text="$psubmitting ? 'Saving...' : ($pformmode === 'create' ? 'Create' : 'Update')">
							</button>
						</div>
					</div>
				</form>
			</div>

			<div class="rounded-2xl border border-[#E5E8DF] bg-white p-8">
				<span class="text-xs font-semibold uppercase tracking-wide text-[#8A9285]">Inventory overview</span>
				<div class="mt-1 flex items-center gap-2">
					<h2 class="text-2xl font-bold tracking-tight text-[#20231F]">Your products</h2>
					<span class="rounded-full bg-[#F0EFE9] px-2.5 py-0.5 text-xs font-semibold text-[#283B28]" id="product-count">0</span>
				</div>

				<div class="mt-6 flex gap-3">
					<input type="text" data-bind:psearch
						data-on:input__debounce.400ms="@get('/admin/products/search?q=' + $psearch + '&category=' + $pcatfilter)"
						class="flex-1 rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
						placeholder="Search products"/>
					<select data-bind:pcatfilter
						data-on:change="@get('/admin/products/search?q=' + $psearch + '&category=' + $pcatfilter)"
						class="rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28]">
						<option value="">All categories</option>
						for _, c := range categories {
							<option value={ strconv.FormatInt(int64(c.ID), 10) }>{ c.Name }</option>
						}
					</select>
				</div>

				<div id="product-list" class="mt-6 flex min-h-[300px] flex-col items-center justify-center gap-2 rounded-xl border border-[#E5E8DF] bg-[#FBFBF9] px-6 py-16 text-center">
					<p class="max-w-xs text-sm text-[#8A9285]">Add your first product with photos, variants, and stock details. It will appear here for you to manage.</p>
				</div>
			</div>

		</div>
	</section>
}


templ OrdersAdminContent() {
	<section data-show="$activetab === 'orders'" class="px-10 py-8">
		<h1 class="text-2xl font-semibold tracking-tight text-[#20231F]">Orders</h1>
		<p class="mt-2 text-sm text-[#63685F]">Your order history will show up here.</p>
	</section>
}

templ MessagesAdminContent() {
	<section data-show="$activetab === 'messages'" class="px-10 py-8">
		<h1 class="text-2xl font-semibold tracking-tight text-[#20231F]">Messages</h1>
		<p class="mt-2 text-sm text-[#63685F]">Your conversations will show up here.</p>
	</section>
}

templ ReviewsAdminContent() {
	<section data-show="$activetab === 'reviews'" class="px-10 py-8">
		<h1 class="text-2xl font-semibold tracking-tight text-[#20231F]">My reviews</h1>
		<p class="mt-2 text-sm text-[#63685F]">Reviews you've written will show up here.</p>
	</section>
}

templ DashboardRenderer(user *db.User, tab string, categories []db.ListCategoriesWithPCRow) {
	@Html("Dashboard", user){
		@dashboard(user, tab, categories)
	}
}
