package views

import (
	"strconv"
	"fmt"
	"github.com/jackc/pgx/v5/pgtype"
	"github.com/sudip-kandel7/eveCollection/internal/db"
)

func textOrEmpty(t pgtype.Text) string {
	if !t.Valid {
		return ""
	}
	return t.String
}

templ dashboard(user *db.User, tab string, categories []db.ListCategoriesWithPCRow, products []db.ListProductsRow) {
	<div class="mx-auto flex w-full flex-1 flex-col lg:flex-row" data-signals:activetab={"'" + tab + "'"}>
		<aside class="w-full shrink-0 border-b border-gray-200 bg-white lg:w-64 lg:border-b-0 lg:border-r">
			<div class="px-4 py-4 sm:px-6 sm:py-6 lg:px-6 lg:py-8">
				<h2 class="text-lg font-semibold text-gray-900">My Account</h2>
				<p class="mt-1 text-sm text-gray-500">Manage your account</p>
			</div>
			<nav class="flex flex-wrap gap-2 px-3 pb-2 lg:block lg:px-3 lg:pb-0">
				@dashboardNavLink("overview", "Overview")
				@dashboardNavLink("category", "Category")
				@dashboardNavLink("products", "Products")
			</nav>
		</aside>

		<div class="flex-1">
			@OverviewContent(user)
			@CategoryAdminContent(categories)
			@ProductsAdminContent(categories, products)
		</div>
	</div>
}

templ dashboardNavLink(tab, label string) {
	<a	href="#"
		data-on:click__prevent={ "$activetab = '" + tab + "'" }
		data-attr:class={ "$activetab === '" + tab + "' ? 'mt-0 block shrink-0 whitespace-nowrap rounded-lg bg-gray-100 px-4 py-3 text-sm font-medium text-gray-900' : 'mt-0 block shrink-0 whitespace-nowrap rounded-lg px-4 py-3 text-sm text-gray-600 transition hover:bg-gray-100 lg:mt-1'" }
	>
		{ label }
	</a>
}

templ OverviewContent(user *db.User) {
	<section data-show="$activetab === 'overview'" class="px-4 py-6 sm:px-6 sm:py-8 lg:px-10 lg:py-8">
		<h1 class="text-2xl font-semibold tracking-tight text-[#20231F]">Overview</h1>
		<p class="mt-2 text-sm text-[#63685F]">Your overall data will show up here.</p>
	</section>
}

templ CategoryAdminContent(categories []db.ListCategoriesWithPCRow) {
	<section id="category-admin" data-show="$activetab === 'category'" class="px-4 py-6 sm:px-6 sm:py-8 lg:px-10 lg:py-8" data-signals:formmode="'create'" data-signals:catactive="true" data-signals:catname="''" data-signals:categoryid="'0'" data-signals:catimage="''" data-signals:catpreview="''" data-signals:submitting="false">
		<h1 class="text-2xl font-semibold tracking-tight text-[#20231F]">Category</h1>
		<p class="mt-2 text-sm text-[#63685F]">Add, edit, or hide product categories.</p>

		<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[280px_1fr]">
			<div class="rounded-2xl border border-[#E5E8DF] bg-white p-4 sm:p-6">
				<h2 class="text-sm font-semibold text-[#20231F]" data-text="$formmode === 'create' ? 'Add category' : 'Edit category'"></h2>
				<p class="mt-1 text-xs text-[#63685F]">
					<span data-show="$formmode === 'create'">Create a new product category.</span>
					<span data-show="$formmode === 'edit'">Update this category's details.</span>
				</p>
				<form class="mt-5" id="category-form" enctype="multipart/form-data"
					data-on:submit__prevent="$submitting = true; $formmode === 'create' ? @post('/admin/categories', {contentType: 'form'}) : @post('/admin/categories/' + $categoryid , {contentType: 'form'})">
					<label class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[#63685F]">Name</label>
					<input type="text" name="name" data-bind:catname
						class="w-full rounded-xl border border-[#DFE5DA] bg-white px-3 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28]"/>
					<div id="err-name" class="mt-1 text-xs text-red-600"></div>

					<label class="mt-7 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-[#DFE5DA] px-4 py-6 text-center text-xs text-[#63685F] hover:bg-[#F7F8F5]">
						<input type="file" name="image" class="hidden" accept="image/jpeg,image/png" data-on:change="acceptCategoryImage(evt.target) && ($catimage = evt.target.files[0].name) && ($catpreview = URL.createObjectURL(evt.target.files[0]))"
						/>
						<img data-attr:src="$catpreview" alt="" class="h-20 w-20 rounded-lg object-cover" data-show="$catpreview !== ''"/>
						<span data-show="$catimage === ''">Click to upload</span>
						<span data-show="$catimage !== ''" data-text="$catimage"></span>
					</label>
					<div id="err-image" class="mt-1 text-xs text-red-600"></div>

					<label class="mt-4 flex items-center gap-2 text-sm text-[#20231F]">
						<input type="checkbox" name="is_active" data-bind:catactive class="h-4 w-4 rounded border-[#DFE5DA]"/>
						Active
					</label>

					<div class="mt-6 flex gap-2">
						<button type="button" data-show="$formmode === 'edit'" data-on:click="$formmode = 'create'; $catname = ''; $catactive = true; $categoryid = '0'; $catimage = ''; $catpreview = ''"
							class="flex-1 whitespace-nowrap rounded-lg border border-[#DFE5DA] bg-white px-4 py-2.5 text-sm font-medium text-[#63685F] transition hover:bg-[#F0EFE9]">
							Cancel
						</button>
						<button type="submit" data-attr:disabled="$submitting"
							class="flex-1 whitespace-nowrap rounded-lg bg-[#283B28] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#3C523C]"
							data-text="$submitting ? 'Saving...' : ($formmode === 'create' ? 'Create' : 'Save changes')"
						></button>
					</div>
				</form>
			</div>

			<div class="flex flex-col gap-2">
				for _, c := range categories {
					<div
						data-attr:class={ "$categoryid === " + strconv.FormatInt(int64(c.ID), 10) + " ? 'group grid grid-cols-[40px_minmax(0,1fr)_auto] items-center gap-3 rounded-xl border-2 border-[#283B28] bg-[#F7F8F5] p-3 transition hover:-translate-y-0.5 hover:shadow-md sm:grid-cols-[40px_1fr_90px_90px_90px]' : 'group grid grid-cols-[40px_minmax(0,1fr)_auto] items-center gap-3 rounded-xl border-2 border-[#E5E8DF] bg-white p-3 transition hover:-translate-y-0.5 hover:shadow-md sm:grid-cols-[40px_1fr_90px_90px_90px]'" }
					>
						<img src={ textOrEmpty(c.ImageUrl) } alt="" class="col-start-1 row-start-1 h-8 w-8 rounded-lg object-cover bg-[#F0EFE9] sm:col-auto sm:row-auto"/>
						<span class="col-start-2 row-start-1 truncate text-sm font-medium text-[#20231F] sm:col-auto sm:row-auto">{ c.Name }</span>

						<a
							href="#"
							data-on:click__prevent={ "$activetab = 'products'; $pcatfilter = '" + strconv.FormatInt(int64(c.ID), 10) + "'; $psearch = ''; @get('/admin/products/search?q=&category=" + strconv.FormatInt(int64(c.ID), 10) + "')" }
							class="relative col-start-3 row-start-1 inline-block justify-self-end text-sm font-semibold text-[#283B28] transition-colors duration-200 hover:text-[#4A704A] sm:col-auto sm:row-auto"
						>
							{ fmt.Sprintf("%02d", c.ProductCount) }
							<span class="absolute bottom-[-3px] left-[-2px] h-[1.5px] w-6 origin-right scale-x-0 bg-[#4A704A] transition-transform duration-300 ease-out group-hover:origin-left group-hover:scale-x-100"></span>
						</a>

						if c.IsActive {
							<span class="col-start-2 row-start-2 w-fit rounded-full bg-[#E7F3E5] px-2.5 py-0.5 text-xs font-medium text-[#2E6B33] sm:col-auto sm:row-auto">Active</span>
						} else {
							<span class="col-start-2 row-start-2 w-fit rounded-full bg-[#FBE9E7] px-2.5 py-0.5 text-xs font-medium text-[#B3392C] sm:col-auto sm:row-auto">Hidden</span>
						}

						<div class="col-start-3 row-start-2 flex justify-self-end gap-1.5 sm:col-auto sm:row-auto">
							<button
								type="button"
								data-on:click={ "$formmode = 'edit'; $categoryid = " + strconv.FormatInt(int64(c.ID), 10) + "; $catname = '" + c.Name + "'; $catactive = " + strconv.FormatBool(c.IsActive)  + "; " +
                "$catpreview = " + strconv.Quote(c.ImageUrl.String) }
								class="rounded-lg border border-[#DFE5DA] p-1.5 text-[#63685F] hover:bg-[#F0EFE9]"
							>
								<img src="/static/public/edit.png" alt="Edit" class="h-4 w-4 transition-transform duration-150 ease-out hover:scale-125"/>
							</button>

							if c.ProductCount == 0 {
								<button
									type="button"
									data-on:click={ "confirm('Delete " + c.Name + "? This can\\'t be undone.') && @post('/admin/categories/" + strconv.FormatInt(int64(c.ID), 10) + "/delete')" }
									class="rounded-lg border border-red-200 p-1.5 hover:bg-red-50"
								>
									<img src="/static/public/delete.png" alt="Delete" class="h-4 w-4 transition-transform duration-150 ease-out hover:scale-125"/>
								</button>
							} else {
								<button type="button" disabled title="Move or delete its products first" class="cursor-not-allowed rounded-lg border border-[#E5E8DF] p-1.5">
									<img src="/static/public/delete.png" alt="Delete (disabled)" class="h-4 w-4 opacity-30"/>
								</button>
							}
						</div>
					</div>
				}

				if len(categories) == 0 {
					<div class="rounded-xl border border-dashed border-[#DFE5DA] p-6 text-center text-sm text-[#63685F] sm:p-10">
						No categories yet — create your first one on the left.
					</div>
				}
			</div>
		</div>
	</section>
}

templ ProductCategorySelect(categories []db.ListCategoriesWithPCRow) {
	<select id="product-category-select" name="category_id" data-bind:pcategory
		data-on:change={ "if (evt.target.value === 'new') { $activetab = 'category'; $pcategory = ''; $formmode = 'create'; $categoryid = '0'; $catname = ''; $catactive = true; $catimage = ''; $catpreview = '' }" }
		class="w-full rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2 text-sm text-[#20231F] outline-none focus:border-[#283B28]">
		<option value="" disabled selected>Choose a category</option>
		for _, c := range categories {
			<option value={ strconv.FormatInt(int64(c.ID), 10) }>{ c.Name }</option>
		}
		<option value="new">Add New</option>
	</select>
}

templ ProductsAdminContent(categories []db.ListCategoriesWithPCRow, products []db.ListProductsRow) {
	<section
		id="products-admin"
		data-show="$activetab === 'products'"
		class="px-4 py-6 sm:px-6 lg:px-10 lg:py-6"
		data-signals:pformmode="'create'"
		data-signals:productid="'0'"
		data-signals:pname="''"
		data-signals:pcategory="''"
		data-signals:pdescription="''"
		data-signals:pprice="''"
		data-signals:pvisible="true"
		data-signals:psubmitting="false"
		data-signals:psearch="''"
		data-signals:pcatfilter="''"
	>
		<div class="grid grid-cols-1 gap-6 xl:grid-cols-2 items-start">

			<div class="rounded-2xl border border-[#E5E8DF] bg-white p-4 sm:p-6">
				<div class="flex items-baseline justify-between">
					<span class="text-xs font-semibold uppercase tracking-wide text-[#8A9285]">Product details</span>
					<span class="text-xs text-[#8A9285]">* Required fields</span>
				</div>
				<h2 class="mt-0.5 text-xl font-bold tracking-tight text-[#20231F]" data-text="$pformmode === 'create' ? 'Add a product' : 'Edit product'"></h2>

				<form
					id="product-form"
					class="mt-4 space-y-4"
					enctype="multipart/form-data"
					data-on:datastar-fetch.document="evt.detail.type === 'finished' && ($psubmitting = false)"
				data-on:submit__prevent="$psubmitting = true; $pformmode === 'create' ? @post('/admin/products', {contentType: 'form'}) : @post('/admin/products/' + $productid, {contentType: 'form'})"
				>
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<div>
							<label class="mb-1.5 block text-sm font-medium text-[#20231F]">Product name <span class="text-xs text-[#8A9285]">*</span></label>
							<input type="text" name="name" data-bind:pname
								class="w-full rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
								placeholder="e.g. Everyday linen shirt"/>
							<div id="err-pname" class="mt-1 text-xs text-red-600"></div>
						</div>
						<div>
							<label class="mb-1.5 block text-sm font-medium text-[#20231F]">Category <span class="text-xs text-[#8A9285]">*</span></label>
							@ProductCategorySelect(categories)
							<div id="err-pcategory" class="mt-1 text-xs text-red-600"></div>
						</div>
					</div>

					<div class="grid grid-cols-1 gap-4 sm:grid-cols-[minmax(0,1fr)_180px]">
						<div>
							<label class="block text-sm font-medium text-[#20231F]">Description</label>
							<textarea name="description" rows="3" data-bind:pdescription
								class="mt-1 w-full rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
								placeholder="Tell customers what makes it special..."></textarea>
							<div id="err-pdescription" class="mt-1 text-xs text-red-600"></div>
						</div>

						<div class="flex flex-col gap-3">
							<div>
								<label class="block text-sm font-medium text-[#20231F]">Base price <span class="text-xs text-[#8A9285]">*</span></label>
								<div class="relative mt-1">
									<span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-sm text-[#8A9285]">Rs.</span>
									<input type="text" name="base_price" data-bind:pprice inputmode="decimal"
										class="w-full rounded-xl border border-[#DFE5DA] bg-white py-2 pl-10 pr-3.5 text-sm text-[#20231F] outline-none focus:border-[#283B28]"
										placeholder="0.00"/>
								</div>
								<div id="err-pprice" class="mt-1 text-xs text-red-600"></div>
							</div>

							<label class="flex w-fit cursor-pointer items-center gap-2 text-sm font-medium text-[#20231F]">
								<input type="checkbox" name="is_active" data-bind:pvisible
									class="h-4 w-4 rounded border-[#DFE5DA]"/>
								Active
							</label>
						</div>
					</div>

					<div>
						<label class="block text-sm font-medium text-[#20231F]">Tags <span class="text-xs text-[#8A9285]">*</span></label>
						<div class="mt-1 flex flex-wrap items-center gap-2 rounded-xl border border-[#DFE5DA] bg-white px-3 py-1.5">
							<div id="tags" class="flex flex-wrap items-center gap-2"></div>
							<input
								type="text"
								id="tag-input"
								class="min-w-[120px] flex-1 border-none p-1 text-sm text-[#20231F] outline-none"
								placeholder="Add another tag..."
								data-on:keydown__prevent--if="evt.key === 'Enter'"
								data-on:keydown="evt.key === 'Enter' && addTag()"
							/>
							<button type="button" id="tag" title="Add tag" aria-label="Add tag"
								data-on:click="addTag()"
								class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#F0EFE9] text-sm font-semibold leading-none text-[#283B28] transition hover:bg-[#E5E8DF]">+</button>
						</div>
						<div id="err-ptags" class="mt-1 text-xs text-red-600"></div>
					</div>

					<div>
						<div class="flex items-baseline justify-between">
							<label class="block text-sm font-medium text-[#20231F]">Product images <span class="text-xs text-[#8A9285]">*</span></label>
							<span class="text-xs text-[#8A9285]">First image is the cover</span>
						</div>
						<label class="mt-1 flex cursor-pointer items-center gap-3 rounded-xl border border-dashed border-[#DFE5DA] px-3 py-2.5 text-sm text-[#63685F] hover:bg-[#F7F8F5]">
							<input type="file" id="images-input" name="images" multiple class="hidden" accept="image/jpeg,image/png"
								data-on:change="addProductImages(evt.target)"
							/>
							<span>
								<span class="block text-sm font-medium text-[#20231F]">Upload product photos</span>
								<span class="block text-xs text-[#8A9285]">JPG or PNG · up to 2MB each</span>
							</span>
						</label>
						<div id="image-previews" class="mt-2 flex flex-wrap gap-2"></div>
						<div id="err-pimages" class="mt-1 text-xs text-red-600"></div>
					</div>


				
					<div class="border-t border-[#E5E8DF] pt-4">
						<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
							<div>
								<h3 class="text-sm font-semibold text-[#20231F]">Variants <span class="text-xs text-[#8A9285]">*</span></h3>
								<p class="text-xs text-[#8A9285]">Stock is tracked for each color and size.</p>
							</div>
							<button
								type="button"
								id="add-variant"
								class="flex shrink-0 items-center gap-1.5 rounded-full border border-[#DFE5DA] bg-white px-3.5 py-2.5 text-sm font-medium text-[#283B28] hover:bg-[#F0EFE9] sm:py-1.5"
							>
								+ Add variant
							</button>
						</div>
						<div id="variants-container" class="mt-3 space-y-2"></div>
						<div id="err-variants" class="mt-1 text-xs text-red-600"></div>
					</div>
					
            

					<div class="flex flex-wrap items-center justify-end gap-2 border-t border-[#E5E8DF] pt-4">
						<div class="flex gap-2">
							<button type="button" data-show="$pformmode === 'edit' && !$psubmitting"
								data-on:click="$pformmode = 'create'; $productid = '0'; $pname = ''; $pcategory = ''; $pdescription = ''; $pprice = ''; $pvisible = true; resetProductExtras()"
								class="whitespace-nowrap rounded-lg border border-[#DFE5DA] bg-white px-4 py-2.5 text-sm font-medium text-[#63685F] transition hover:bg-[#F0EFE9] sm:py-2">
								Cancel
							</button>
							<button type="submit" data-attr:disabled="$psubmitting"
								class="whitespace-nowrap rounded-lg bg-[#283B28] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#3C523C] sm:py-2"
								data-text="$psubmitting ? 'Saving...' : ($pformmode === 'create' ? 'Create' : 'Update')">
							</button>
						</div>
					</div>
				</form>
			</div>

			<div class="rounded-2xl border border-[#E5E8DF] bg-white p-4 sm:p-6">
				<span class="text-xs font-semibold uppercase tracking-wide text-[#8A9285]">Inventory overview</span>
				<div class="mt-0.5 flex items-center gap-2">
					<h2 class="text-xl font-bold tracking-tight text-[#20231F]">Your products</h2>
					@ProductCount(len(products))
				</div>

				<div class="mt-4 flex flex-col gap-3 sm:flex-row">
					<input type="text" data-bind:psearch
						data-on:input__debounce.400ms="@get('/admin/products/search?q=' + $psearch + '&category=' + $pcatfilter)"
						class="w-full flex-1 rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28] sm:py-2"
						placeholder="Search products"/>
					<select data-bind:pcatfilter
						data-on:change="@get('/admin/products/search?q=' + $psearch + '&category=' + $pcatfilter)"
						class="w-full rounded-xl border border-[#DFE5DA] bg-white px-3.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28] sm:w-auto sm:py-2">
						<option value="">All categories</option>
						for _, c := range categories {
							<option value={ strconv.FormatInt(int64(c.ID), 10) }>{ c.Name }</option>
						}
					</select>
				</div>

				<div class="max-h-[62vh] overflow-y-auto pr-1">
					@ProductsList(products)
				</div>
			</div>

		</div>
	</section>
}


templ ProductCount(count int) {
	<span id="product-count" class="rounded-full bg-[#F0EFE9] px-2.5 py-0.5 text-xs font-semibold text-[#283B28]">{ strconv.Itoa(count) }</span>
}

func priceOverrideText(v float64) string {
	if v <= 0 {
		return ""
	}
	return strconv.FormatFloat(v, 'f', 2, 64)
}

templ ProductVariantRows(variants []db.ListProductVariantsRow) {
	for i, v := range variants {
		<div class="variant-row rounded-xl border border-[#E5E8DF] bg-[#FBFBF9] p-3">
			<div class="flex items-center justify-between">
				<span class="variant-number text-xs font-semibold uppercase tracking-wide text-[#8A9285]">{ fmt.Sprintf("Variant %d", i+1) }</span>
				<button type="button" class="remove-variant text-xs font-medium text-red-500 hover:text-red-700">Remove</button>
			</div>
			<div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
				<div>
					<label class="mb-1 block text-xs font-medium text-[#63685F]">Color <span class="text-xs text-[#8A9285]">*</span></label>
					<input type="text" name={ "variants[" + strconv.Itoa(i) + "].color" } value={ textOrEmpty(v.Color) } class="w-full rounded-lg border border-[#DFE5DA] bg-white px-2.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28] sm:py-1.5"/>
				</div>
				<div>
					<label class="mb-1 block text-xs font-medium text-[#63685F]">Size <span class="text-xs text-[#8A9285]">*</span></label>
					<input type="text" name={ "variants[" + strconv.Itoa(i) + "].size" } value={ textOrEmpty(v.Size) } class="w-full rounded-lg border border-[#DFE5DA] bg-white px-2.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28] sm:py-1.5"/>
				</div>
				<div>
					<label class="mb-1 block text-xs font-medium text-[#63685F]">Stock <span class="text-xs text-[#8A9285]">*</span></label>
					<input type="number" min="0" inputmode="numeric" name={ "variants[" + strconv.Itoa(i) + "].stock" } value={ strconv.Itoa(int(v.Stock)) } class="w-full rounded-lg border border-[#DFE5DA] bg-white px-2.5 py-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28] sm:py-1.5"/>
				</div>
				<div>
					<label class="mb-1 block text-xs font-medium text-[#63685F]">Price</label>
					<div class="relative">
						<span class="pointer-events-none absolute inset-y-0 left-2.5 flex items-center text-xs text-[#8A9285]">Rs.</span>
						<input type="text" inputmode="decimal" name={ "variants[" + strconv.Itoa(i) + "].price" } value={ priceOverrideText(v.PriceOverride) } placeholder="Base" class="w-full rounded-lg border border-[#DFE5DA] bg-white py-2.5 pl-8 pr-2.5 text-sm text-[#20231F] outline-none focus:border-[#283B28] sm:py-1.5"/>
					</div>
				</div>
			</div>
		</div>
	}
}

templ ProductTagChips(tags []string) {
	for _, name := range tags {
		<div class="flex items-center gap-2 rounded-lg bg-[#EEF2EB] px-2.5 py-1 text-xs text-[#283B28]">
			<input type="hidden" name="tags[]" value={ name }/>
			<span>{ name }</span>
			<button type="button" class="font-bold text-[#63685F] hover:text-red-600" data-on:click="evt.target.parentElement.remove()">×</button>
		</div>
	}
}

templ ProductsList(products []db.ListProductsRow) {
	<div id="product-list" class="mt-6 flex flex-col gap-2">
		if len(products) == 0 {
			<div class="rounded-xl border border-dashed border-[#DFE5DA] p-6 text-center text-sm text-[#63685F] sm:p-10">
				Add your first product with photos, variants, and stock details.
			</div>
		} else {
			for _, p := range products {
				<div
					data-attr:class={ "$productid === " + strconv.FormatInt(int64(p.ID), 10) + " ? 'group grid grid-cols-[40px_minmax(0,1fr)_auto] items-center gap-3 rounded-xl border-2 border-[#283B28] bg-[#F7F8F5] p-3 transition hover:-translate-y-0.5 hover:shadow-md sm:grid-cols-[40px_1fr_90px_90px_90px]' : 'group grid grid-cols-[40px_minmax(0,1fr)_auto] items-center gap-3 rounded-xl border-2 border-[#E5E8DF] bg-white p-3 transition hover:-translate-y-0.5 hover:shadow-md sm:grid-cols-[40px_1fr_90px_90px_90px]'" }
				>
					if img, ok := p.CoverImage.(string); ok && img != "" {
						<img src={ img } alt="" class="col-start-1 row-start-1 h-8 w-8 rounded-lg object-cover bg-[#F0EFE9] sm:col-auto sm:row-auto"/>
					} else {
						<div class="col-start-1 row-start-1 flex h-8 w-8 items-center justify-center rounded-lg bg-[#F0EFE9] text-[9px] font-semibold text-[#8A9285] sm:col-auto sm:row-auto">
							N/A
						</div>
					}

					<div class="col-start-2 row-start-1 min-w-0 sm:col-auto sm:row-auto">
						<p class="truncate text-sm font-medium text-[#20231F]">{ p.Name }</p>
						<p class="truncate text-xs text-[#8A9285]">{ p.CategoryName }</p>
					</div>

					<span class="col-start-3 row-start-1 justify-self-end text-sm font-semibold text-[#283B28] sm:col-auto sm:row-auto">{ fmt.Sprintf("%02d", p.TotalStock) }</span>

					if p.IsActive {
						<span class="col-start-2 row-start-2 w-fit rounded-full bg-[#E7F3E5] px-2.5 py-0.5 text-xs font-medium text-[#2E6B33] sm:col-auto sm:row-auto">Active</span>
					} else {
						<span class="col-start-2 row-start-2 w-fit rounded-full bg-[#FBE9E7] px-2.5 py-0.5 text-xs font-medium text-[#B3392C] sm:col-auto sm:row-auto">Hidden</span>
					}

					<div class="col-start-3 row-start-2 flex justify-self-end gap-1.5 sm:col-auto sm:row-auto">
						<button
							type="button"
							data-on:click={ "@get('/admin/products/" + strconv.FormatInt(int64(p.ID), 10) + "/edit')" }
							class="rounded-lg border border-[#DFE5DA] p-1.5 text-[#63685F] hover:bg-[#F0EFE9]"
						>
							<img src="/static/public/edit.png" alt="Edit" class="h-4 w-4 transition-transform duration-150 ease-out hover:scale-125"/>
						</button>

						<button type="button" disabled title="Product delete is not wired up yet" class="cursor-not-allowed rounded-lg border border-[#E5E8DF] p-1.5">
							<img src="/static/public/delete.png" alt="Delete (disabled)" class="h-4 w-4 opacity-30"/>
						</button>
					</div>
				</div>
			}
		}
	</div>
}


templ DashboardRenderer(user *db.User, tab string, categories []db.ListCategoriesWithPCRow, products []db.ListProductsRow) {
	@Html("Dashboard", user, "dashboard"){
		@dashboard(user, tab, categories, products)
	}
}
