package views

import "github.com/sudip-kandel7/eveCollection/internal/db"

templ aboutContent() {
	<div style="font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;">
		<section class="relative overflow-hidden border-b border-[#E7E5DE] bg-[#F7F8F5]">
			<div class="relative mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
				<div class="max-w-3xl">
					<span class="inline-flex items-center rounded-full border border-[#DCE4D4] bg-white/70 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-[#5B744E]">
						About the project
					</span>
					<h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight text-[#20231F] sm:text-6xl lg:text-7xl">
						An e-commerce website,
						<br/>
						<span class="italic text-[#638154]">built from scratch.</span>
					</h1>
					<p class="mt-6 max-w-[620px] text-base leading-relaxed text-[#687064] sm:text-lg">
						Eve Collection was designed and developed by Sudip Kandel and Kushal Pandit as our 6th Semester Project II.
					</p>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
			<div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#6B7D60]">Why we built it</p>
					<h2 class="mt-3 text-[30px] font-extrabold leading-tight tracking-tight text-[#20231F] sm:text-4xl">
						A practical project,
						<br/>
						built end to end.
					</h2>
					<p class="mt-6 text-base leading-relaxed text-[#687064]">
						For our 6th semester Project II, we wanted to go beyond a static website and build something that works like a real online store. We chose an e-commerce site so we could bring together frontend design, backend logic, and a database in one project.
					</p>
					<p class="mt-4 text-base leading-relaxed text-[#687064]">
						The result is Eve Collection: a clothing store with product browsing, search and category filters, user accounts, and an admin dashboard for managing the shop.
					</p>
				</div>

				<div class="relative overflow-hidden rounded-[28px] border border-[#E5E8DF] bg-white p-7 sm:p-10">
					<div class="relative">
						<span class="inline-flex items-center rounded-full border border-[#DCE4D4] bg-white/70 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-[#5B744E]">
							Project details
						</span>
						<div class="mt-7 space-y-5">
							<div class="border-b border-[#DCE4D4] pb-4">
								<p class="text-xs font-semibold uppercase tracking-wide text-[#7A8374]">Course</p>
								<p class="mt-1 text-sm font-medium text-[#20231F]">6th Semester · Project II</p>
							</div>
							<div class="border-b border-[#DCE4D4] pb-4">
								<p class="text-xs font-semibold uppercase tracking-wide text-[#7A8374]">Built by</p>
								<p class="mt-1 text-sm font-medium text-[#20231F]">Sudip Kandel</p>
								<p class="text-sm font-medium text-[#20231F]">Kushal Pandit</p>
							</div>
							<div class="border-b border-[#DCE4D4] pb-4">
								<p class="text-xs font-semibold uppercase tracking-wide text-[#7A8374]">Built with</p>
								<p class="mt-1 text-sm font-medium text-[#20231F]">Go, templ, Tailwind CSS, Datastar, PostgreSQL</p>
							</div>
							<div>
								<p class="text-xs font-semibold uppercase tracking-wide text-[#7A8374]">Project</p>
								<p class="mt-1 text-sm font-medium text-[#20231F]">Eve Collection — an online clothing store</p>
							</div>
						</div>
						<div class="mt-8 flex items-center gap-3 border-t border-[#DCE4D4] pt-5">
							<span class="h-2 w-2 rounded-full bg-[#638154]"></span>
							<p class="text-xs font-medium uppercase tracking-[0.16em] text-[#6B7D60]">Made for learning, built to work</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="border-y border-[#E2E8DB] bg-white">
			<div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
				<div class="max-w-2xl">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#6B7D60]">What we built</p>
					<h2 class="mt-3 text-[30px] font-extrabold leading-tight tracking-tight text-[#20231F] sm:text-4xl">
						The main parts of
						<span class="italic text-[#638154]">the website.</span>
					</h2>
				</div>
				<div class="mt-9 grid gap-4 sm:grid-cols-3 sm:gap-5">
					<div class="rounded-[24px] border border-[#E5E8DF] bg-[#F7F8F5] p-6">
						<h3 class="text-lg font-semibold text-[#20231F]">Storefront</h3>
						<p class="mt-2 text-sm leading-relaxed text-[#687064]">
							Browse the collection, search for products, and filter items by category.
						</p>
					</div>
					<div class="rounded-[24px] border border-[#E5E8DF] bg-[#F7F8F5] p-6">
						<h3 class="text-lg font-semibold text-[#20231F]">User accounts</h3>
						<p class="mt-2 text-sm leading-relaxed text-[#687064]">
							Customers can register, sign in, and keep their profile details up to date.
						</p>
					</div>
					<div class="rounded-[24px] border border-[#E5E8DF] bg-[#F7F8F5] p-6">
						<h3 class="text-lg font-semibold text-[#20231F]">Admin dashboard</h3>
						<p class="mt-2 text-sm leading-relaxed text-[#687064]">
							Store owners can manage categories and products from one simple dashboard.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-7 sm:flex-row sm:items-center sm:justify-between sm:px-8">
			<div class="flex flex-col">
				<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#6B7D60]">Thanks for visiting</p>
				<h2 class="mt-3 max-w-xl text-[30px] font-extrabold leading-tight tracking-tight text-[#20231F] sm:text-4xl">
					Have a look around our project.
				</h2>
			</div>
			<a href="/#collection" class="inline-flex w-fit items-center gap-2 rounded-full bg-[#283B28] px-6 py-3 text-sm font-semibold text-[#F7F8F5] shadow-sm transition hover:bg-[#20261F]">
				Explore Eve Collection
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6"></path>
				</svg>
			</a>
		</section>
	</div>
}

templ AboutRenderer(user *db.User) {
	@Html("About", user, "about") {
		@aboutContent()
	}
}
