package views

import (
	"github.com/sudip-kandel7/eveCollection/internal/db"
)

templ messagesPage() {
	<div class="mx-auto w-full max-w-4xl px-5 py-10 sm:px-8">
		<h1 class="text-2xl font-semibold tracking-tight text-[#20231F]">Messages</h1>
		<p class="mt-2 text-sm text-[#63685F]">Your conversations will show up here.</p>
	</div>
}

templ MessagesRenderer(user *db.User) {
	@Html("Messages", user, "messages") {
		@messagesPage()
	}
}

templ AdminMessagesRenderer(user *db.User) {
	@Html("Messages | Admin", user, "messages") {
		@messagesPage()
	}
}
