package views

import (
	"strconv"

	"github.com/sudip-kandel7/eveCollection/internal/db"
)

templ index(categories []db.ListCategoriesWithProductsRow, trendingCards []db.ListProductsCardRow, productsCard []db.ListProductsCardRow) {
	@hero()
	@trending(trendingCards)
	@collection(categories, productsCard)
}


templ trending(productsCard []db.ListProductsCardRow) {
	<section
		id="trending"
		class="relative overflow-hidden border-y border-[#E2E8DB] bg-[#F7F8F5]"
		style="font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;"
	>
		<div class="relative mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">
			<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<span class="inline-flex items-center gap-2 rounded-full bg-[#283B28] px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-[#F7F8F5] shadow-sm">
						<svg viewBox="0 0 24 24" class="h-4 w-4 drop-shadow-[0_0_5px_rgba(255,138,0,0.6)]" aria-hidden="true">
							<defs>
								<linearGradient id="trending-fire" x1="12" y1="2" x2="12" y2="21" gradientUnits="userSpaceOnUse">
									<stop offset="0" stop-color="#FF3B2F"></stop>
									<stop offset="0.45" stop-color="#FF8A00"></stop>
									<stop offset="1" stop-color="#FFD84D"></stop>
								</linearGradient>
								<linearGradient id="trending-fire-core" x1="12" y1="12" x2="12" y2="21" gradientUnits="userSpaceOnUse">
									<stop offset="0" stop-color="#FFE66D"></stop>
									<stop offset="1" stop-color="#FFF6C2"></stop>
								</linearGradient>
							</defs>
							<path fill="url(#trending-fire)" d="M13.5 2c.2 2.4-.4 3.8-1.6 5.1-1 1.2-2.4 2.1-2.4 3.9 0 1 .6 1.8 1.4 2.2-.1-1.1.3-2 1.1-2.7 0 1.4.8 2.4 1.8 3.3 1.1 1 2.2 2 2.2 3.7a4.5 4.5 0 0 1-1.4 3.2A7 7 0 1 0 6 12.5c0-2.1 1-3.8 2.2-5.4C9.6 5 11 3.8 11.2 2c1 .5 1.8 1.4 2.2 2.5 0-1 .1-1.8.1-2.5z"></path>
							<path fill="url(#trending-fire-core)" d="M12 21a2.6 2.6 0 0 1-2.6-2.6c0-1.5 1.1-2.2 1.8-3.4.2.8.6 1.4 1.2 1.9.7.6 1.2 1.2 1.2 2.1A2.6 2.6 0 0 1 12 21z"></path>
						</svg>
						Trending now
					</span>
					<h2 class="mt-3 text-[30px] font-extrabold leading-tight tracking-tight text-[#20231F] sm:text-4xl">
						What everyone's <span class="italic text-[#638154]">loving</span>.
					</h2>
					<p class="mt-2 max-w-[460px] text-sm leading-relaxed text-[#687064]">
						The pieces moving fast this week, picked by the people who wear them.
					</p>
				</div>
				<button
					data-on:click__prevent="document.getElementById('collection')?.scrollIntoView({behavior: 'smooth'})"
					class="inline-flex w-fit items-center gap-2 rounded-full bg-[#283B28] px-5 py-2.5 text-sm font-medium text-[#F7F8F5] shadow-sm transition hover:bg-[#20261F]"
				>
					Browse all products
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6"></path>
					</svg>
				</button>
			</div>
			<div class="relative mt-8">
				<div class="-mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mx-0 sm:gap-5 sm:px-0">
					for i, product := range productsCard {
							@trendingCard(product, i+1)
					}
				</div>
			</div>
		</div>
	</section>
}

templ trendingCard(p db.ListProductsCardRow, rank int) {
	<a
		href={ templ.URL("/products/" + strconv.Itoa(int(p.ID))) }
		class="group relative w-[78%] shrink-0 snap-start overflow-hidden rounded-[22px] border border-[#DCE4D4] bg-[#F0EFE9] shadow-[0_10px_30px_-20px_rgba(40,59,40,0.5)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_22px_45px_-24px_rgba(40,59,40,0.55)] sm:w-[calc(50%-0.625rem)] lg:w-[calc(25%-0.9375rem)]"
	>
		<div class="relative aspect-[3/4] w-full overflow-hidden">
			if p.CoverImage != "" {
				<img
					src={ p.CoverImage }
					alt={ p.Name }
					loading="lazy"
					class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.05]"
				/>
			}
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#151A13]/90 via-[#151A13]/25 to-transparent"
			></div>
			<span class="absolute left-3 top-3 flex h-8 min-w-8 items-center justify-center rounded-full bg-[#E6FF75] px-2 text-xs font-extrabold tracking-tight text-[#20261F] shadow-sm">
				{ trendingRank(rank) }
			</span>
			if p.Stock == 0 {
				<span class="absolute right-3 top-3 rounded-full bg-[#D40000] px-2.5 py-1 text-[11px] font-semibold text-white shadow-sm">Sold out</span>
			}
			<div class="absolute inset-x-0 bottom-0 p-4">
				<p class="truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-[#E6FF75]">{ p.CategoryName }</p>
				<h3 class="mt-1 line-clamp-2 text-base font-semibold leading-snug text-white">{ p.Name }</h3>
				<div class="mt-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
					<span class="text-base font-bold text-white">{ formatPrice(p.Price) }</span>
					<span class="flex items-center gap-1.5 whitespace-nowrap text-[11px] text-white/75">
						<svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 text-[#E6FF75]" aria-hidden="true">
							<path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.5l-5.88 3.11 1.12-6.55-4.76-4.64 6.58-.96z"></path>
						</svg>
						<span class="leading-none">{ strconv.FormatFloat(p.Rating, 'f', 1, 64) }</span>
						<span class="text-white/40">|</span>
						<span class="leading-none">{ strconv.Itoa(int(p.Sold)) } sold</span>
					</span>
				</div>
			</div>
		</div>
	</a>
}

templ hero() {
	<section
		class="relative overflow-hidden border-b border-[#E7E5DE] bg-[#F7F8F5]"
		style="font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;"
	>
		<div
			aria-hidden="true"
			class="pointer-events-none absolute left-[7%] top-6 h-52 w-52 rounded-full bg-[#E9F6A9]/65 blur-[80px]"
		></div>
		<div
			aria-hidden="true"
			class="pointer-events-none absolute -top-12 right-[4%] h-80 w-80 rounded-full bg-[#D6E8C8]/80 blur-[100px]"
		></div>
		<div class="relative mx-auto flex min-h-[500px] max-w-7xl flex-col justify-center px-5 py-14 sm:px-8">
			<div class="max-w-[700px]">
				<h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight text-[#20231F] sm:text-6xl lg:text-7xl">
					Good things,
					<br/>
					<span class="italic text-[#638154]">chosen well.</span>
				</h1>
				<p class="mt-6 max-w-[580px] text-base leading-relaxed text-[#687064] sm:text-lg">
					Find clothes that fit your life, from daily wear to something special.
				</p>
				<button
					type="button"
					data-on:click__prevent="document.getElementById('collection')?.scrollIntoView({behavior: 'smooth'})"
					class="mt-7 inline-flex items-center gap-2 rounded-full bg-[#283B28] px-6 py-3 text-sm font-semibold text-[#F7F8F5] shadow-sm transition hover:bg-[#20261F]"
				>
					Shop
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6"></path>
					</svg>
				</button>
				<form
					data-signals:search="''"
					data-on:submit__prevent="$cat = '0'; $sort= 'Featured' ; @get('/products/filter'); document.getElementById('collection').scrollIntoView({behavior: 'smooth'})"
					class="mt-9 flex max-w-[640px] items-center gap-3"
				>
					<div class="flex h-16 flex-1 items-center gap-3 rounded-2xl border border-[#E7E5DE] bg-white/90 px-5 shadow-[0_10px_30px_-12px_rgba(32,35,31,0.25)] backdrop-blur transition">
						<svg viewBox="0 0 24 24" fill="none" stroke="#8A9285" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0" aria-hidden="true">
							<circle cx="11" cy="11" r="7"></circle>
							<path d="m20 20-3.2-3.2"></path>
						</svg>
						<input
							id="hero-search"
							type="text"
							data-bind:search
							placeholder="Search the collection"
							class="h-full w-full bg-transparent text-base text-[#20231F] outline-none placeholder:text-[#8A9285]"
						/>
						<button
							type="button"
							data-show="$search.length"
							data-on:click="$search = ''"
							aria-label="Clear search"
							class="shrink-0 rounded-full p-1 text-[#8A9285] transition hover:bg-[#F0EFE9] hover:text-[#20231F]"
						>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
								<path d="M18 6 6 18M6 6l12 12"></path>
							</svg>
						</button>
					</div>
					<button
						type="submit"
						data-show="$search.length"
						class="h-12 shrink-0 rounded-xl bg-[#283B28] px-5 text-sm font-semibold text-[#F7F8F5] shadow-[0_10px_30px_-12px_rgba(32,35,31,0.45)] transition hover:bg-[#20261F]"
					>
						Search
					</button>
				</form>
			</div>
		</div>
	</section>
}

templ collection(categories []db.ListCategoriesWithProductsRow, productsCard []db.ListProductsCardRow) {
	<section
		id="collection"
		class="scroll-mt-28 bg-[#F7F8F5] md:scroll-mt-20"
		style="font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;"
		data-signals:filters-open="false"
		data-signals:sort-open="false"
		data-signals:sort="'Featured'"
		data-signals:cat="'0'"
	>
		<div class="mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">
			<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#6B7D60]">
						The collection
					</p>
					<h2 class="mt-2 text-[30px] font-extrabold leading-tight tracking-tight text-[#20231F] sm:text-4xl">
						Find your next favorite.
					</h2>
				</div>
				<div class="flex flex-wrap items-center gap-3">
					<button
						type="button"
						data-on:click="$filtersOpen = !$filtersOpen"
						data-attr:aria-expanded="$filtersOpen"
						class="inline-flex items-center gap-2 rounded-full border border-[#DCE2D7] bg-white px-4 py-2.5 text-sm font-medium text-[#283B28] shadow-sm transition hover:border-[#283B28]/30 hover:bg-[#F3F5F0]"
					>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
							<line x1="4" y1="8" x2="20" y2="8"></line>
							<line x1="4" y1="16" x2="20" y2="16"></line>
							<circle cx="9" cy="8" r="2"></circle>
							<circle cx="15" cy="16" r="2"></circle>
						</svg>
						Filters
					</button>
					<div class="relative">
						<button
							type="button"
							data-on:click="$sortOpen = !$sortOpen"
							class="inline-flex items-center gap-2 rounded-full border border-[#DCE2D7] bg-white px-4 py-2.5 text-sm font-medium text-[#283B28] shadow-sm transition hover:border-[#283B28]/30 hover:bg-[#F3F5F0]"
						>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
								<path d="M7 4v16M7 4 4 7M7 4l3 3"></path>
								<path d="M17 20V4M17 20l3-3M17 20l-3-3"></path>
							</svg>
							<span data-text="$sort">Featured</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
								<path d="m6 9 6 6 6-6"></path>
							</svg>
						</button>
						<div
							data-show="$sortOpen"
							class="absolute right-0 z-20 mt-2 w-56 overflow-hidden rounded-2xl border border-[#E5E8DF] bg-white p-1.5 shadow-xl"
						>
							for _, option := range []string{"Featured", "Price: low to high", "Price: high to low", "Top rated"} {
								<button
									type="button"
									data-on:click={ "$sort = '" + option + "'; $sortOpen = false; @get('/products/filter')" }
									data-attr:class={ sortOptClass("$sort === '" + option + "'") }
									class={ sortOptOff }
								>
									{ option }
								</button>
							}
						</div>
					</div>
				</div>
			</div>
			<div class="category-panel border-t-2 border-b-2 border-gray-200 p-5" data-attr:class={ categoryPanelClass("$filtersOpen") }>
					<p class="text-xs font-semibold uppercase tracking-wide text-[#6B7D60]">Category</p>
					<div class="mt-3 flex flex-wrap gap-2.5">
						<button
							type="button"
							data-on:click={ "$cat = '0'; @get('/products/filter')" }
							data-attr:class={ chipClass("$cat === '0'") }
							class={ chipClassOff }
						>
							All
						</button>
						for _, cat := range categories {
							if cat.IsActive {
								<button
									type="button"
									data-on:click={ "$cat = '" + strconv.Itoa(int(cat.ID)) + "'; @get('/products/filter')" }
									data-attr:class={ chipClass("$cat === '" + strconv.Itoa(int(cat.ID)) + "'") }
									class={ chipClassOff }
								>
									{ cat.Name }
								</button>
							}
						}
				</div>
			</div>
			@ProductGrid(productsCard)
		</div>
	</section>
}

templ ProductGrid(productsCard []db.ListProductsCardRow) {
	<div id="product-grid" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
		for _, product := range productsCard {
			@productCard(product)
		}
		if len(productsCard) == 0 {
			<div class="col-span-full rounded-xl border border-dashed border-[#DFE5DA] p-10 text-center text-sm text-[#63685F]">
				<p>No products match your search.</p>
				<a
					href="#hero-search"
					onclick="event.preventDefault(); const el = document.getElementById('hero-search'); if (el) { el.focus({ preventScroll: true }); el.scrollIntoView({ behavior: 'smooth', block: 'center' }); el.setSelectionRange(el.value.length, el.value.length); }"
					class="mt-2 inline-block font-medium text-[#283B28] underline underline-offset-4 transition hover:text-[#638154]"
				>
					Try a different word
				</a>
			</div>
		}
	</div>
}

templ productCard(p db.ListProductsCardRow) {
	<a
		href={ templ.URL("/products/" + strconv.Itoa(int(p.ID))) }
		class="group block overflow-hidden rounded-2xl border border-[#E5E8DF] bg-white shadow-[0_1px_2px_rgba(32,35,31,0.04)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_36px_-20px_rgba(40,59,40,0.45)]"
	>
		<div class="relative aspect-[4/5] w-full overflow-hidden bg-[#F0EFE9]">
			if p.CoverImage != "" {
					<img
						src={ p.CoverImage }
						alt={ p.Name }
						loading="lazy"
						class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
					/>
			}
			if p.Stock == 0 {
				<span class="absolute right-2 top-2 rounded-full bg-[#D40000] px-2.5 py-1 text-[11px] font-semibold text-white shadow-sm">Sold out</span>
			} else if p.Stock < 10 {
				<span class="absolute right-2 top-2 rounded-full bg-[#F5C542] px-2.5 py-1 text-[11px] font-semibold text-[#5C4600] shadow-sm">Only { strconv.Itoa(int(p.Stock)) } left</span>
			}
		</div>
		<div class="px-3 pb-3 pt-3">
			<p class="truncate text-[11px] font-semibold uppercase tracking-wide text-[#8A9285]">{ p.CategoryName }</p>
			<h3 class="mt-1 line-clamp-2 min-h-[2.5rem] text-sm font-semibold leading-snug text-[#20231F]">{ p.Name }</h3>
			<div class="mt-1 flex flex-wrap items-center justify-between gap-2">
				<span class="text-sm font-bold text-[#283B28]">{ formatPrice(p.Price) }</span>
				<span class="flex items-center gap-2 whitespace-nowrap text-xs text-[#6B7468]">
					// if p.ReviewCount > 0 {
					// 	<span class="flex items-center gap-1">
					// 		<img src="/static/public/star.png" class="block h-4 w-4" alt="rating icon"/>
					// 		<span class="leading-none">{ strconv.FormatFloat(p.Rating, 'f', 1, 64) }</span>
					// 	</span>
					// }
					// if p.ReviewCount > 0 && p.Sold > 0 {
					// 	<span class="text-[#C7CBC1]">|</span>
					// }
					// if p.Sold > 0 {
					// 	<span class="leading-none">{ strconv.Itoa(int(p.Sold)) } sold</span>
					// }
						<span class="flex items-center gap-1">
							<img src="/static/public/star.png" class="block h-4 w-4" alt="rating icon"/>
							<span class="leading-none">{ strconv.FormatFloat(p.Rating, 'f', 1, 64) }</span>
						</span>
						<span class="text-[#C7CBC1]">|</span>
						<span class="leading-none">{ strconv.Itoa(int(p.Sold)) } sold</span>
				</span>
			</div>
		</div>
	</a>
}

templ IndexRenderer(user *db.User, categories []db.ListCategoriesWithProductsRow, trendingCards []db.ListProductsCardRow, productsCard []db.ListProductsCardRow) {
	@Html("Eve collection", user, "home") {
		@index(categories, trendingCards, productsCard)
	}
}

func formatPrice(price float64) string {
	return "Rs. " + strconv.FormatFloat(price, 'f', -1, 64)
}

func trendingRank(n int) string {
	if n < 10 {
		return "0" + strconv.Itoa(n)
	}
	return strconv.Itoa(n)
}

const chipBase = "rounded-full border px-5 py-2.5 text-sm font-medium transition "
const chipClassOff = chipBase + "border-[#DCE2D7] bg-white text-[#5B6B4F] hover:bg-[#EEF3E7]"
const chipClassOn = chipBase + "border-[#283B28] bg-[#283B28] text-[#E6FF75]"

func categoryPanelClass(cond string) string {
	base := "category-panel border-t-2 border-b-2 border-gray-200 p-5"
	return cond + " ? " + strconv.Quote(base+" is-open") + " : " + strconv.Quote(base)
}

func chipClass(cond string) string {
	return cond + " ? " + strconv.Quote(chipClassOn) + " : " + strconv.Quote(chipClassOff)
}

const sortOptBase = "block w-full rounded-xl px-3.5 py-2 text-left text-sm transition "
const sortOptOff = sortOptBase + "text-[#4A5443] hover:bg-[#F3F5F0]"
const sortOptOn = sortOptBase + "bg-[#F3F5F0] font-semibold text-[#283B28]"

func sortOptClass(cond string) string {
	return cond + " ? " + strconv.Quote(sortOptOn) + " : " + strconv.Quote(sortOptOff)
}
