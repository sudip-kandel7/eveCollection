package views

import "github.com/sudip-kandel7/eveCollection/views/components"

type LoginFormData struct {
	Identifier     string
	FieldErrors    map[string]string
	NonFieldErrors []string
}

templ login(form LoginFormData) {
	<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#F7F8F5] px-4 sm:px-6">
		<div class="pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-[#E6F4A5] opacity-50 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-24 -right-24 h-96 w-96 rounded-full bg-[#D8E9CF] opacity-60 blur-3xl"></div>

		<div class="relative w-full max-w-md">
			<div class="rounded-[24px] border border-[#E5E8DF] bg-white px-5 pt-6 pb-5 shadow-sm sm:px-10 sm:pt-10 sm:pb-6">
				<span class="block text-xs font-semibold uppercase tracking-[0.16em] text-[#63685F]">
					Welcome back
				</span>

				<h1 class="mt-2 text-2xl font-bold text-[#20231F]">
					Sign in to eve Collection
				</h1>

				<div id="err-nonfield"></div>

				<form class="mt-3 flex flex-col gap-5" data-on:submit__prevent="@post('/login', {contentType: 'form'})">
					<div>
						<label for="identifier" class="mb-1.5 block text-sm font-medium text-[#20231F]">
							Phone or email
						</label>

						<input
							id="identifier"
							name="identifier"
							type="text"
							value={form.Identifier}
							class="w-full rounded-xl border border-[#DFE5DA] bg-white px-4 py-2.5 text-sm text-[#20231F] outline-none transition focus:border-[#283B28] focus:ring-2 focus:ring-[#283B28]/15"
							placeholder="you@example.com"
						/>

						<div id="err-identifier"></div>
					</div>

					<div data-signals:showPassword="false">
						<label for="password" class="mb-1.5 block text-sm font-medium text-[#20231F]">
							Password
						</label>

						<div class="relative">
							<input
								id="password"
								name="password"
								data-attr:type="$showPassword ? 'text' : 'password'"
								autocomplete="current-password"
								class="w-full rounded-xl border border-[#DFE5DA] bg-white px-4 py-2.5 pr-11 text-sm text-[#20231F] outline-none transition focus:border-[#283B28] focus:ring-2 focus:ring-[#283B28]/15"
								placeholder="••••••••"
							/>

							<button
								type="button"
								aria-label="Toggle password visibility"
								data-on:click="$showPassword = !$showPassword"
								class="absolute inset-y-0 right-0 flex w-11 items-center justify-center text-[#63685F] hover:text-[#20231F]"
							>
								<img
									src="/static/public/invisible.png"
									data-show="$showPassword"
									alt="Hide password"
									class="h-7 w-7 opacity-70"
								/>
								<img
									src="/static/public/visible.png"
									data-show="!$showPassword"
									alt="Show password"
									class="h-7 w-7 opacity-70"
								/>
							</button>
						</div>

						<div id="err-password"></div>
					</div>

					<div class="flex -my-3 px-1 justify-end">
						<a
							href="/forgot-password"
							class="text-sm font-medium text-[#283B28] hover:text-[#3C523C]"
						>
							Forgot password?
						</a>
					</div>

					<button
						type="submit"
						class="w-full rounded-full bg-[#283B28] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#3C523C]"
					>
						Sign in
					</button>
				</form>

				<p class="mt-5 text-center text-sm text-[#63685F]">
					Don't have an account?
					<a
						href="/register"
						class="font-semibold text-[#283B28] hover:text-[#3C523C]"
					>
						Create one
					</a>
				</p>
			</div>

			<a
				href="/"
				class="mt-5 flex items-center justify-center gap-2 text-sm font-medium text-[#63685F] transition hover:text-[#283B28]"
			>
				<img
					src="/static/public/left.png"
					alt=""
					class="h-4 w-4"
				/>
				<span>Back to Home</span>
			</a>
		</div>
	</div>
}

templ LoginRenderer(form LoginFormData) {
	<html>
		@components.Head("Login")
		<body class="bg-[#F7F8F5]">
			@login(form)
		</body>
	</html>
}

