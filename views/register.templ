package views

import "github.com/sudip-kandel7/eveCollection/views/components"

type RegisterFormData struct {
	Name        string
	Phone       string
	Email       string
	Address     string
	FieldErrors map[string]string
}

templ register(form RegisterFormData) {
	<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#F7F8F5] px-4 sm:px-6">
		<div class="pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-[#D8E9CF] opacity-60 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-24 -right-24 h-96 w-96 rounded-full bg-[#E6F4A5] opacity-50 blur-3xl"></div>

		<div class="relative w-full max-w-md">
			<div class="rounded-[24px] border border-[#E5E8DF] bg-white p-5 shadow-sm sm:p-10">
				<span class="text-xs font-semibold uppercase tracking-[0.16em] text-[#63685F]">
					Join Eve Collection
				</span>

				<h1 class="mt-2 text-2xl font-bold tracking-[-0.02em] text-[#20231F]">
					Create your account
				</h1>

				<div id="err-nonfield"></div>

				<form class="mt-5 space-y-5" data-on:submit__prevent="@post('/register', {contentType: 'form'})">
					<div>
						<label for="name" class="mb-1.5 block text-sm font-medium text-[#20231F]">
							Full name
						</label>
						<input
							id="name"
							name="name"
							type="text"
							autocomplete="name"
							value={form.Name}
							class="w-full rounded-xl border border-[#DFE5DA] bg-white px-4 py-2.5 text-sm text-[#20231F] outline-none transition focus:border-[#283B28] focus:ring-2 focus:ring-[#283B28]/15"
							placeholder="Jane Doe"
						/>
						<div id="err-name"></div>
					</div>

					<div>
						<label for="phone" class="mb-1.5 block text-sm font-medium text-[#20231F]">
							Phone number
						</label>
						<input
							id="phone"
							name="phone"
							type="tel"
							value={form.Phone}
							autocomplete="tel"
							class="w-full rounded-xl border border-[#DFE5DA] bg-white px-4 py-2.5 text-sm text-[#20231F] outline-none transition focus:border-[#283B28] focus:ring-2 focus:ring-[#283B28]/15"
							placeholder="9877777791"
						/>
						<div id="err-phone"></div>
					</div>

					<div>
						<label for="email" class="mb-1.5 block text-sm font-medium text-[#20231F]">
							Email address
						</label>
						<input
							id="email"
							name="email"
							type="email"
							value={form.Email}
							autocomplete="email"
							class="w-full rounded-xl border border-[#DFE5DA] bg-white px-4 py-2.5 text-sm text-[#20231F] outline-none transition focus:border-[#283B28] focus:ring-2 focus:ring-[#283B28]/15"
							placeholder="you@example.com"
						/>
						<div id="err-email"></div>
					</div>

					<div>
						<label for="address" class="mb-1.5 block text-sm font-medium text-[#20231F]">Address</label>
						<input id="address" name="address" type="text" value={form.Address} autocomplete="address"
						class="w-full rounded-xl border border-[#DFE5DA] bg-white px-4 py-2.5 text-sm text-[#20231F] outline-none transition focus:border-[#283B28] focus:ring-2 focus:ring-[#283B28]/15" placeholder="Bharatpur" /> 
						<div id="err-address"></div>
					</div>

					<div data-signals:showPassword="false">
						<label for="password" class="mb-1.5 block text-sm font-medium text-[#20231F]">
							Password
						</label>

						<div class="relative">
							<input
								id="password"
								name="password"
								data-attr:type="$showPassword ? 'text' : 'password'"
								autocomplete="new-password"
								class="w-full rounded-xl border border-[#DFE5DA] bg-white px-4 py-2.5 pr-11 text-sm text-[#20231F] outline-none transition focus:border-[#283B28] focus:ring-2 focus:ring-[#283B28]/15"
								placeholder="••••••••"
							/>

							<button
								type="button"
								aria-label="Toggle password visibility"
								data-on:click="$showPassword = !$showPassword"
								class="absolute inset-y-0 right-0 flex w-11 items-center justify-center text-[#63685F] hover:text-[#20231F]"
							>
								<img
									src="/static/public/invisible.png"
									data-show="$showPassword"
									alt="Hide password"
									class="h-7 w-7 opacity-70"
								/>
								<img
									src="/static/public/visible.png"
									data-show="!$showPassword"
									alt="Show password"
									class="h-7 w-7 opacity-70"
								/>
							</button>
						</div>

						<div id="err-password"></div>
					</div>

					<div data-signals:showConfirmPassword="false">
						<label for="confirm-password" class="mb-1.5 block text-sm font-medium text-[#20231F]">
							Confirm password
						</label>

						<div class="relative">
							<input
								id="confirm-password"
								name="confirm_password"
								data-attr:type="$showConfirmPassword ? 'text' : 'password'"
								autocomplete="new-password"
								class="w-full rounded-xl border border-[#DFE5DA] bg-white px-4 py-2.5 pr-11 text-sm text-[#20231F] outline-none transition focus:border-[#283B28] focus:ring-2 focus:ring-[#283B28]/15"
								placeholder="••••••••"
							/>

							<button
								type="button"
								aria-label="Toggle confirm password visibility"
								data-on:click="$showConfirmPassword = !$showConfirmPassword"
								class="absolute inset-y-0 right-0 flex w-11 items-center justify-center text-[#63685F] hover:text-[#20231F]"
							>
								<img
									src="/static/public/invisible.png"
									data-show="$showConfirmPassword"
									alt="Hide password"
									class="h-7 w-7 opacity-70"
								/>
								<img
									src="/static/public/visible.png"
									data-show="!$showConfirmPassword"
									alt="Show password"
									class="h-7 w-7 opacity-70"
								/>
							</button>
						</div>

						<div id="err-confirmPassword"></div>
					</div>

					<button
						type="submit"
						class="w-full rounded-full bg-[#283B28] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#3C523C]"
					>
						Create account
					</button>
				</form>

				<p class="mt-6 text-center text-sm text-[#63685F]">
					Already have an account?
					<a href="/login" class="font-semibold text-[#283B28] hover:text-[#3C523C]">
						Sign in
					</a>
				</p>
			</div>

			<a
				href="/"
				class="mt-3 flex items-center justify-center gap-2 text-sm font-medium text-[#63685F] transition hover:text-[#283B28]"
			>
				<img
					src="/static/public/left.png"
					alt=""
					class="h-4 w-4"
				/>
				<span>Back to Home</span>
			</a>
		</div>
	</div>
}

templ RegisterRenderer(form RegisterFormData) {
	<html>
		@components.Head("Register")
		<body class="bg-[#F7F8F5]">
			@register(form)
		</body>
	</html>
}